# Repository-wide editor and C# analyzer conventions.
# Keep this file at the solution/repository root.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
max_line_length = 100

# -----------------------------------------------------------------------------
# C#
# -----------------------------------------------------------------------------
[*.cs]
indent_size = 4

# Formatting / structure
csharp_prefer_braces = true:error
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

# var: use it when the assigned type is obvious; prefer explicit types otherwise.
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_elsewhere = false:warning

# Prefer immutability where the compiler/analyzer can prove it is safe.
dotnet_style_readonly_field = true:warning

# Prefer modern pattern matching when it produces a direct equivalent.
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Build-visible diagnostics corresponding to the written standards.
dotnet_diagnostic.IDE0011.severity = error
# IDE0011: Add braces
dotnet_diagnostic.IDE0044.severity = warning
# IDE0044: Make field readonly
dotnet_diagnostic.IDE0055.severity = error
# IDE0055: Fix formatting
dotnet_diagnostic.IDE1006.severity = error
# IDE1006: Naming rule violation
dotnet_diagnostic.CA1031.severity = warning
# CA1031: Do not catch general exception types; suppress only at a justified boundary.

# Naming styles

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_style.interface_pascal_case.required_prefix = I
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case

dotnet_naming_style.pascal_case_async.required_suffix = Async
dotnet_naming_style.pascal_case_async.capitalization = pascal_case

# Interfaces: IPascalCase

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_begin_with_i.style = interface_pascal_case
dotnet_naming_rule.interfaces_should_begin_with_i.severity = error

# Types: PascalCase. (C# records are included by class.)

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_should_be_pascal_case.severity = error

# Methods, local functions, properties, and events: PascalCase.

dotnet_naming_symbols.members.applicable_kinds = method, local_function, property, event
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_rule.members_should_be_pascal_case.symbols = members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.members_should_be_pascal_case.severity = error

# Async methods/local functions: PascalCase + Async suffix.
# This more-specific rule takes precedence over the general member rule.

dotnet_naming_symbols.async_functions.applicable_kinds = method, local_function
dotnet_naming_symbols.async_functions.applicable_accessibilities = *
dotnet_naming_symbols.async_functions.required_modifiers = async

dotnet_naming_rule.async_functions_should_end_in_async.symbols = async_functions
dotnet_naming_rule.async_functions_should_end_in_async.style = pascal_case_async
dotnet_naming_rule.async_functions_should_end_in_async.severity = error

# Parameters and locals: camelCase.

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_symbols.parameters_and_locals.applicable_accessibilities = *

dotnet_naming_rule.parameters_and_locals_should_be_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.severity = error

# Constants: PascalCase. This prevents private const fields from being caught by
# the broader private-field rule below.

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.constants_should_be_pascal_case.severity = error

# Private fields: _camelCase.

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_rule.private_fields_should_be_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_should_be_underscore_camel_case.severity = error

# Public fields are public members and therefore PascalCase.

dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public

dotnet_naming_rule.public_fields_should_be_pascal_case.symbols = public_fields
dotnet_naming_rule.public_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.public_fields_should_be_pascal_case.severity = error

# -----------------------------------------------------------------------------
# JavaScript
# -----------------------------------------------------------------------------
[*.{js,mjs,cjs}]
indent_size = 2

# -----------------------------------------------------------------------------
# CSS
# -----------------------------------------------------------------------------
[*.css]
indent_size = 4

# -----------------------------------------------------------------------------
# Microsoft SQL Server / T-SQL
# -----------------------------------------------------------------------------
[*.sql]
indent_size = 4

# -----------------------------------------------------------------------------
# JSON / YAML
# -----------------------------------------------------------------------------
[*.{json,jsonc,yml,yaml}]
indent_size = 2

# Markdown may intentionally contain trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
